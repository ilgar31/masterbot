# Адрес твоего уже написанного API.
# Если API запускается на этом же сервере на порту 8000, оставь так.
BOT_API_BASE_URL=http://localhost:8000

# Авторизация к твоему API.
# Заполняй только то, что реально проверяет твой backend.
# Если авторизации пока нет, оставь пустыми.
BOT_API_TOKEN=
BOT_API_TOKEN_HEADER=Authorization
BOT_API_TOKEN_PREFIX=Bearer 
BOT_API_KEY=
BOT_API_KEY_HEADER=apikey
BOT_API_TIMEOUT=5

# Локальная база бота и текст согласия.
BOT_DATABASE_PATH=data/bot.sqlite3
BOT_CONSENT_FILE=consent.txt
BOT_HOST=0.0.0.0
BOT_PORT=8080
BOT_NAME=Бот клиники

# VK Long Poll.
# Токен берется в сообществе: Управление -> Работа с API -> Ключи доступа.
VK_GROUP_TOKEN=

# ID сообщества. В твоем случае из JSON подтверждения VK: group_id = 238688218.
VK_GROUP_ID=238688218

# Эти поля нужны только для Callback API. Для Long Poll можно оставить пустыми.
VK_CONFIRMATION_TOKEN=
VK_SECRET_KEY=
VK_API_VERSION=5.199

# Админка.
ADMIN_ENABLED=1
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8081
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
